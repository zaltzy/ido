rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two owners may read or write. Replace the addresses below.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['OWNER_1_EMAIL', 'OWNER_2_EMAIL'];
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
    // Reminder feed: readable only by exact document id (an unguessable token), never listable.
    match /feed/{token} {
      allow get: if true;
    }
    // New leads found in email are dropped here under the same token; the dashboard moves them into leads.
    match /inbox/{token}/items/{id} {
      allow create: if exists(/databases/$(database)/documents/feed/$(token))
        && request.resource.data.keys().hasOnly(['name', 'phone', 'notes', 'createdAt', 'gmailThreadId'])
        && request.resource.data.size() <= 5;
    }
  }
}
